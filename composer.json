{
    "name": "yabasha/laravel-clsx",
    "description": "A Laravel utility for conditional class name concatenation, inspired by the JS clsx package.",
    "type": "library",
    "homepage": "https://yabasha.dev",
    "license": "MIT",
    "keywords": ["laravel", "css", "clsx", "php"],
    "authors": [
        {
            "name": "Bashar Ayyash",
            "email": "hello@yabasha.dev",
            "homepage": "https://yabasha.dev",
            "role": "Developer"
        }
    ],
    "authors": [
        {
            "name": "Yabasha",
            "email": "bashar.ayyash@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0"
    },
    "suggest": {
        "illuminate/support": "For macroable and Blade directive support"
    },
    "autoload": {
        "psr-4": {
            "Yabasha\\Clsx\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Yabasha\\Clsx\\LaravelClsxServiceProvider"
            ]
        }
    }
}
